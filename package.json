{
  "name": "evidence-based-skill-gap-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ingestion": "node --conditions=react-server --import tsx --test tests/ingestion/*.test.ts",
    "test:analysis": "node --conditions=react-server --import tsx --test tests/analysis/*.test.ts",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai/*.test.ts",
    "test:ai:live": "node --conditions=react-server --import tsx --env-file=.env.local scripts/test-skill-extraction-live.mts",
    "test:validation": "node --conditions=react-server --import tsx --test tests/validation/*.test.ts",
    "test:validation:live": "node --conditions=react-server --import tsx --env-file=.env.local scripts/test-validation-live.mts",
    "test:scoring": "node --conditions=react-server --import tsx --test tests/scoring/*.test.ts",
    "test:roadmap": "node --conditions=react-server --import tsx --test tests/roadmap/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
